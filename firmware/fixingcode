const char* ssid = "Dialog 4G 231";
const char* password = "Mihiranga#17";

const uint16_t server_port = 8000;
const char* ws_path = "/ws/stationary";
const uint16_t udp_discovery_port = 12345;

// ==========================================
// SENSOR PINS
// ==========================================
#define PH_SENSOR_PIN    34
#define DHT_PIN           4
#define LDR_PIN          35
#define MQ135_PIN        32
#define PZEM_RX_PIN      16
#define PZEM_TX_PIN      17

// ==========================================
// GANTRY PINS
// ==========================================
#define X_STEP_PIN       12
#define X_DIR_PIN        13
#define X_ENABLE_PIN     14
#define Y_STEP_PIN       25
#define Y_DIR_PIN        33
#define Y_ENABLE_PIN     26

// Limit switches are wired normally open to GND with INPUT_PULLUP.
#define LIMIT_X_PIN      18
#define LIMIT_Y_PIN      19

// ==========================================
// DIRECT RELAY OUTPUTS (ACTIVE LOW)
// ==========================================
#define RELAY_PUMP_PIN   22
#define RELAY_FAN_PIN    21
#define RELAY_LED_PIN    23

// ==========================================
// OBJECTS
// ==========================================
AccelStepper stepperX(AccelStepper::DRIVER, X_STEP_PIN, X_DIR_PIN);
AccelStepper stepperY(AccelStepper::DRIVER, Y_STEP_PIN, Y_DIR_PIN);
PZEM004Tv30 pzem(Serial2, PZEM_RX_PIN, PZEM_TX_PIN);
DHT dht(DHT_PIN, DHT22);
WebsocketsClient client;
WiFiUDP udp;

// ==========================================
// RUNTIME STATE
// ==========================================
String serverIp = "";
unsigned long lastWsRetry = 0;
unsigned long lastSensorSend = 0;
unsigned long lastHeartbeat = 0;
unsigned long lastStatusPrint = 0;
unsigned long pumpStartTime = 0;
bool isPumpRunning = false;
bool inSafeMode = false;
bool isHoming = false;
bool motorDriversEnabled = false;
bool wifiConnectInProgress = false;
unsigned long wifiConnectStartedAt = 0;
unsigned long lastWiFiDot = 0;
unsigned long nextWiFiRetryAt = 0;
unsigned long lastMdnsLogAt = 0;
bool mdnsFailureLogged = false;
bool pumpRelayOn = false;
bool fanRelayOn = false;
bool ledRelayOn = false;

const unsigned long WS_RETRY_INTERVAL_MS = 5000;
const unsigned long SENSOR_INTERVAL_MS = 2000;
const unsigned long HEARTBEAT_INTERVAL_MS = 5000;
const unsigned long STATUS_INTERVAL_MS = 3000;
const unsigned long MAX_PUMP_TIME_MS = 90000;
const unsigned long WIFI_CONNECT_TIMEOUT_MS = 20000;
const unsigned long MDNS_LOG_INTERVAL_MS = 30000;

// ==========================================
// HELPERS
// ==========================================
void setRelayState(uint8_t pin, bool on) {
  if (pin == RELAY_PUMP_PIN) {
    pumpRelayOn = on;
  } else if (pin == RELAY_FAN_PIN) {
    fanRelayOn = on;
  } else if (pin == RELAY_LED_PIN) {
    ledRelayOn = on;
  }

  pinMode(pin, on ? OUTPUT : INPUT);
}

void allOutputsSafeOff() {
  setRelayState(RELAY_PUMP_PIN, false);
  setRelayState(RELAY_FAN_PIN, false);
  setRelayState(RELAY_LED_PIN, false);
  digitalWrite(X_ENABLE_PIN, HIGH);
  digitalWrite(Y_ENABLE_PIN, HIGH);
  motorDriversEnabled = false;
  isPumpRunning = false;
}

void triggerSafeMode(const String& reason) {
  if (inSafeMode) return;

  inSafeMode = true;
  Serial.println("!!! SAFE MODE: " + reason + " !!!");
  stepperX.stop();
  stepperY.stop();
  allOutputsSafeOff();

  if (client.available()) {
    StaticJsonDocument<128> doc;
    doc["error"] = reason;
    String payload;
    serializeJson(doc, payload);
    client.send(payload);
  }
}

void setMotorDriversEnabled(bool enabled) {
  digitalWrite(X_ENABLE_PIN, enabled ? LOW : HIGH);
  digitalWrite(Y_ENABLE_PIN, enabled ? LOW : HIGH);
  motorDriversEnabled = enabled;
}

void homeGantry() {
  isHoming = true;
  Serial.println("[GANTRY] Homing started...");

  stepperX.setMaxSpeed(500);
  stepperY.setMaxSpeed(500);
  stepperX.setSpeed(-400);
  stepperY.setSpeed(-400);

  bool xHomed = false;
  bool yHomed = false;
  while (!xHomed || !yHomed) {
    if (!xHomed && digitalRead(LIMIT_X_PIN) == HIGH) {
      stepperX.runSpeed();
    } else {
      xHomed = true;
    }

    if (!yHomed && digitalRead(LIMIT_Y_PIN) == HIGH) {
      stepperY.runSpeed();
    } else {
      yHomed = true;
    }

    if (client.available()) client.poll();
  }

  stepperX.setCurrentPosition(0);
  stepperY.setCurrentPosition(0);
  isHoming = false;
  Serial.println("[GANTRY] Homing complete");
}

void connectToWiFi() {
  if (WiFi.status() == WL_CONNECTED) {
    wifiConnectInProgress = false;
    return;
  }

  if (wifiConnectInProgress) {
    return;
  }

  WiFi.disconnect(true, true);
  WiFi.mode(WIFI_OFF);
  delay(200);
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.begin(ssid, password);
  wifiConnectInProgress = true;
  wifiConnectStartedAt = millis();
  lastWiFiDot = wifiConnectStartedAt;

  Serial.print("[WiFi] Connecting to ");
  Serial.println(ssid);
}

void updateWiFiConnection() {
  wl_status_t status = WiFi.status();

  if (status == WL_CONNECTED) {
    if (wifiConnectInProgress) {
      wifiConnectInProgress = false;
      Serial.println();
      Serial.print("[WiFi] Connected. IP: ");
      Serial.println(WiFi.localIP());
    }
    return;
  }

  if (!wifiConnectInProgress) {
    return;
  }

  unsigned long now = millis();
  if (now - lastWiFiDot >= 500) {
    Serial.print(".");
    lastWiFiDot = now;
  }

  if (now - wifiConnectStartedAt >= WIFI_CONNECT_TIMEOUT_MS) {
    wifiConnectInProgress = false;
    Serial.println();
    Serial.println("[WiFi] Connection failed");
    WiFi.disconnect(true, true);
    WiFi.mode(WIFI_OFF);
    nextWiFiRetryAt = now + WS_RETRY_INTERVAL_MS;
  }
}

bool startMdnsResponder() {
  if (!MDNS.begin("hydrogrow-stationary")) {
    Serial.println("[mDNS] Responder start failed");
    return false;
  }

  Serial.println("[mDNS] Responder started as hydrogrow-stationary.local");
  return true;
}

bool discoverServerMdns() {
  unsigned long now = millis();
  bool shouldLog = !mdnsFailureLogged || (now - lastMdnsLogAt >= MDNS_LOG_INTERVAL_MS);
  if (shouldLog) {
    Serial.println("[mDNS] Looking up _hydrogrow._tcp.local");
  }

  int serviceCount = MDNS.queryService("hydrogrow", "tcp");
  if (serviceCount <= 0) {
    if (shouldLog) {
      Serial.println("[mDNS] No Hydro Grow service found, using UDP fallback");
      lastMdnsLogAt = now;
      mdnsFailureLogged = true;
    }
    return false;
  }

  String hostName = MDNS.hostname(0);
  IPAddress resolvedIp;
  if (hostName.length() == 0) {
    if (shouldLog) {
      Serial.println("[mDNS] Service found, but hostname was empty");
      lastMdnsLogAt = now;
      mdnsFailureLogged = true;
    }
    return false;
  }

  if (!MDNS.queryHost(hostName.c_str(), resolvedIp)) {
    if (shouldLog) {
      Serial.print("[mDNS] Failed to resolve host ");
      Serial.print(hostName);
      Serial.println(", using UDP fallback");
      lastMdnsLogAt = now;
      mdnsFailureLogged = true;
    }
    return false;
  }

  serverIp = resolvedIp.toString();
  mdnsFailureLogged = false;
  Serial.print("[mDNS] Found server at ");
  Serial.print(serverIp);
  Serial.print(":");
  Serial.println(MDNS.port(0));
  return true;
}

bool discoverServerUdp() {
  Serial.println("[UDP] Falling back to UDP discovery");

  udp.stop();
  if (!udp.begin(udp_discovery_port)) {
    Serial.println("[UDP] Failed to open local UDP socket");
    return false;
  }

  udp.beginPacket("255.255.255.255", udp_discovery_port);
  udp.print("HYDRO_DISCOVER");
  if (!udp.endPacket()) {
    Serial.println("[UDP] Failed to send discovery packet");
    udp.stop();
    return false;
  }

  unsigned long start = millis();
  while (millis() - start < 3000) {
    int packetSize = udp.parsePacket();
    if (packetSize > 0) {
      char buffer[64] = {0};
      int len = udp.read(buffer, sizeof(buffer) - 1);
      if (len > 0) buffer[len] = '\0';

      String response = String(buffer);
      if (response.startsWith("HYDRO_SERVER_HERE:")) {
        serverIp = udp.remoteIP().toString();
        Serial.print("[UDP] Found server at ");
        Serial.print(serverIp);
        Serial.print(":");
        Serial.println(server_port);
        udp.stop();
        return true;
      }
    }
    delay(50);
  }

  Serial.println("[UDP] No discovery response received");
  udp.stop();
  return false;
}

bool connectWebSocket() {
  if (serverIp.length() == 0) {
    if (!discoverServerMdns() && !discoverServerUdp()) {
      return false;
    }
  }

  String wsUrl = "ws://" + serverIp + ":" + String(server_port) + ws_path;
  Serial.print("[WS] Connecting to ");
  Serial.println(wsUrl);

  if (client.connect(wsUrl.c_str())) {
    Serial.println("[WS] Connection successful");
    return true;
  }

  Serial.println("[WS] Connection failed");
  serverIp = "";
  return false;
}

// ==========================================
// WEBSOCKET CALLBACKS
// ==========================================
void onEventsCallback(WebsocketsEvent event, String data) {
  if (event == WebsocketsEvent::ConnectionOpened) {
    Serial.println("[WS] Connected to server");
  } else if (event == WebsocketsEvent::ConnectionClosed) {
    Serial.println("[WS] Disconnected - outputs safe OFF");
    allOutputsSafeOff();
  } else if (event == WebsocketsEvent::GotPing) {
    client.pong();
  }
}

void handleStateSync(JsonObject actuators) {
  if (actuators.isNull()) return;

  const char* pump = actuators["pump"];
  const char* fan = actuators["fan"];
  const char* ledStrip = actuators["led_strip"];

  if (pump) {
    setRelayState(RELAY_PUMP_PIN, strcmp(pump, "ON") == 0);
  }

  if (fan) {
    setRelayState(RELAY_FAN_PIN, strcmp(fan, "ON") == 0);
  }

  if (ledStrip) {
    setRelayState(RELAY_LED_PIN, strcmp(ledStrip, "OFF") != 0);
  }
}

void onMessageCallback(WebsocketsMessage message) {
  StaticJsonDocument<512> doc;
  if (deserializeJson(doc, message.data())) {
    return;
  }

  const char* type = doc["type"];
  if (type && strcmp(type, "state_sync") == 0) {
    handleStateSync(doc["actuators"].as<JsonObject>());
    Serial.println("[WS] State sync received");
    return;
  }

  const char* component = doc["component"];
  const char* action = doc["action"];
  if (!component || !action) return;

  Serial.printf("[CMD] %s -> %s\n", component, action);

  if (strcmp(component, "pump") == 0) {
    setRelayState(RELAY_PUMP_PIN, strcmp(action, "ON") == 0);
    return;
  }

  if (strcmp(component, "fan") == 0) {
    setRelayState(RELAY_FAN_PIN, strcmp(action, "ON") == 0);
    return;
  }

  if (strcmp(component, "led_strip") == 0) {
    setRelayState(RELAY_LED_PIN, strcmp(action, "OFF") != 0);
    return;
  }

  if (strcmp(component, "motors") == 0) {
    bool enabled = strcmp(action, "ON") == 0;
    setMotorDriversEnabled(enabled);
    if (enabled && inSafeMode) {
      inSafeMode = false;
    }
    return;
  }

  if (inSafeMode) return;

  if (strcmp(component, "gantry") == 0 && strcmp(action, "HOME") == 0) {
    homeGantry();
    return;
  }

  if (strcmp(component, "move") == 0) {
    stepperX.moveTo(doc["x"] | 0);
    stepperY.moveTo(doc["y"] | 0);
  }
}

// ==========================================
// SENSOR PACKET
// ==========================================
float readPhValue() {
  float phVoltage = analogRead(PH_SENSOR_PIN) * (3.3f / 4095.0f);
  return -5.70f * phVoltage + 21.34f;
}

float readLightPercent() {
  return 100.0f - (analogRead(LDR_PIN) / 4095.0f * 100.0f);
}

float readAirQualityPercent() {
  return analogRead(MQ135_PIN) / 4095.0f * 100.0f;
}

const char* getPhStatus(float phValue) {
  return (phValue >= 0.0f && phValue <= 14.0f) ? "OK" : "WARN";
}

const char* getDhtStatus(float temp, float hum) {
  return (!isnan(temp) && !isnan(hum)) ? "OK" : "ERROR";
}

const char* getPzemStatus(float power) {
  return isnan(power) ? "ERROR" : "OK";
}

const char* getLimitState(uint8_t pin) {
  return digitalRead(pin) == LOW ? "TRIGGERED" : "OPEN";
}

void sendSensorPacket() {
  StaticJsonDocument<512> doc;

  doc["ph"] = readPhValue();

  float power = pzem.power();
  if (isnan(power)) {
    doc["energy_status"] = "ERROR";
    doc["energy_voltage"] = 0.0;
    doc["energy_current"] = 0.0;
    doc["energy_power"] = 0.0;
    doc["energy_total"] = 0.0;
  } else {
    doc["energy_status"] = "OK";
    doc["energy_voltage"] = pzem.voltage();
    doc["energy_current"] = pzem.current();
    doc["energy_power"] = power;
    doc["energy_total"] = pzem.energy();
  }

  float temp = dht.readTemperature();
  float hum = dht.readHumidity();
  if (!isnan(temp)) doc["temp"] = temp;
  if (!isnan(hum)) doc["hum"] = hum;

  doc["light"] = readLightPercent();
  doc["air_quality"] = readAirQualityPercent();

  String output;
  serializeJson(doc, output);
  client.send(output);

  Serial.printf(
    "[SENSORS] pH:%.2f T:%.1fC H:%.1f%% L:%.1f%% AQ:%.1f%% Power:%.2fW\n",
    doc["ph"].as<float>(),
    isnan(temp) ? -1.0f : temp,
    isnan(hum) ? -1.0f : hum,
    doc["light"].as<float>(),
    doc["air_quality"].as<float>(),
    doc["energy_power"].as<float>()
  );
}

void sendHeartbeat() {
  float phValue = readPhValue();
  float temp = dht.readTemperature();
  float hum = dht.readHumidity();
  float power = pzem.power();
  float voltage = isnan(power) ? 0.0f : pzem.voltage();
  float current = isnan(power) ? 0.0f : pzem.current();
  float energyTotal = isnan(power) ? 0.0f : pzem.energy();

  StaticJsonDocument<768> doc;
  doc["type"] = "heartbeat";
  doc["status"] = inSafeMode ? "SAFE_MODE" : "OK";
  doc["heap"] = ESP.getFreeHeap();
  doc["wifi_rssi"] = WiFi.RSSI();
  doc["safe_mode"] = inSafeMode;
  doc["homing"] = isHoming;
  doc["motor_enabled"] = motorDriversEnabled;
  doc["energy_status"] = getPzemStatus(power);
  doc["energy_voltage"] = voltage;
  doc["energy_current"] = current;
  doc["energy_power"] = isnan(power) ? 0.0f : power;
  doc["energy_total"] = energyTotal;

  JsonObject sensors = doc.createNestedObject("sensors");
  sensors["ph"] = getPhStatus(phValue);
  sensors["dht22"] = getDhtStatus(temp, hum);
  sensors["pzem"] = getPzemStatus(power);
  sensors["ldr"] = "OK";
  sensors["mq135"] = "OK";

  JsonObject actuators = doc.createNestedObject("actuators");
  actuators["pump"] = pumpRelayOn ? "ON" : "OFF";
  actuators["fan"] = fanRelayOn ? "ON" : "OFF";
  actuators["led_strip"] = ledRelayOn ? "ON" : "OFF";

  JsonObject limits = doc.createNestedObject("limits");
  limits["x"] = getLimitState(LIMIT_X_PIN);
  limits["y"] = getLimitState(LIMIT_Y_PIN);

  String output;
  serializeJson(doc, output);
  client.send(output);

  Serial.printf(
    "[HEARTBEAT] status:%s RSSI:%d heap:%u V:%.1f I:%.3f P:%.1f pump:%s fan:%s led:%s\n",
    doc["status"].as<const char*>(),
    WiFi.RSSI(),
    ESP.getFreeHeap(),
    voltage,
    current,
    doc["energy_power"].as<float>(),
    actuators["pump"].as<const char*>(),
    actuators["fan"].as<const char*>(),
    actuators["led_strip"].as<const char*>()
  );
}

// ==========================================
// SETUP
// ==========================================
void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("====================================");
  Serial.println(" Hydro Grow Controller ESP32 ");
  Serial.println("====================================");

  pinMode(RELAY_PUMP_PIN, INPUT);
  pinMode(RELAY_FAN_PIN, INPUT);
  pinMode(RELAY_LED_PIN, INPUT);

  pinMode(X_ENABLE_PIN, OUTPUT);
  pinMode(Y_ENABLE_PIN, OUTPUT);
  pinMode(LIMIT_X_PIN, INPUT_PULLUP);
  pinMode(LIMIT_Y_PIN, INPUT_PULLUP);
  allOutputsSafeOff();

  stepperX.setMaxSpeed(1000);
  stepperX.setAcceleration(500);
  stepperY.setMaxSpeed(1000);
  stepperY.setAcceleration(500);

  dht.begin();

  connectToWiFi();
  client.onEvent(onEventsCallback);
  client.onMessage(onMessageCallback);
}

// ==========================================
// LOOP
// ==========================================
void loop() {
  unsigned long now = millis();
  updateWiFiConnection();

  if (WiFi.status() != WL_CONNECTED) {
    if (!wifiConnectInProgress && now >= nextWiFiRetryAt) {
      lastWsRetry = now;
      Serial.println("[WiFi] Reconnecting...");
      connectToWiFi();
    }
    return;
  }

  static bool mdnsStarted = false;
  if (!mdnsStarted) {
    mdnsStarted = startMdnsResponder();
  }

  if (client.available()) {
    client.poll();
  } else if (now - lastWsRetry >= WS_RETRY_INTERVAL_MS) {
    lastWsRetry = now;
    Serial.println("[WS] Reconnecting...");
    serverIp = "";
    connectWebSocket();
  }

  if (!inSafeMode) {
    stepperX.run();
    stepperY.run();
  }

  if (!isHoming && !inSafeMode) {
    if (digitalRead(LIMIT_X_PIN) == LOW) triggerSafeMode("X_CRASH");
    if (digitalRead(LIMIT_Y_PIN) == LOW) triggerSafeMode("Y_CRASH");
  }

  if (client.available() && now - lastSensorSend >= SENSOR_INTERVAL_MS) {
    lastSensorSend = now;
    sendSensorPacket();
  }

  if (client.available() && now - lastHeartbeat >= HEARTBEAT_INTERVAL_MS) {
    lastHeartbeat = now;
    sendHeartbeat();
  }

  if (now - lastStatusPrint >= STATUS_INTERVAL_MS) {
    lastStatusPrint = now;
    Serial.println(client.available() ? "[STATUS] Connected" : "[STATUS] Not connected");
  }
}
